# Keep Wrapper and actual local build dependencies (+ source attachments).
# build.gradle resolves dev.xkmc exclusively from libs: preserve clone builds.
!**/gradle/wrapper/gradle-wrapper.jar
!/libs/fast_projectile_api-*.jar
!/libs/l2core-*.jar
!/libs/l2damagetracker-*.jar
!/libs/l2itemselector-*.jar
!/libs/l2library-*.jar
!/libs/l2magic-*.jar
!/libs/l2menustacker-*.jar
!/libs/l2modularblocks-*.jar
!/libs/l2serial-*.jar
!/libs/l2tabs-*.jar

